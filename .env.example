# Molecule AI local environment
# Copy to .env and fill values. Never commit secrets.

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql+psycopg2://molecule:molecule@localhost:5432/molecule_ai
# Tests fall back to SQLite if DATABASE_URL is unset.
REDIS_URL=redis://localhost:6379/0

XAI_API_KEY=
XAI_MODEL=grok-4
XAI_API_BASE=https://api.x.ai/v1

DATA_DIR=./var/data
DUCKDB_PATH=./var/molecule.duckdb

# Object storage is optional in v0.1. Leave blank to use local Parquet.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
